[
  { "key": "ctrl+h", "command": "workbench.action.navigateLeft", "when": "!inQuickOpen && !suggestWidgetVisible && !(editorTextFocus && vim.mode == 'Insert')" },
  { "key": "ctrl+j", "command": "workbench.action.navigateDown", "when": "!inQuickOpen && !suggestWidgetVisible && !(editorTextFocus && vim.mode == 'Insert')" },
  { "key": "ctrl+k", "command": "workbench.action.navigateUp", "when": "!inQuickOpen && !suggestWidgetVisible && !(editorTextFocus && vim.mode == 'Insert')" },
  { "key": "ctrl+l", "command": "workbench.action.navigateRight", "when": "!inQuickOpen && !suggestWidgetVisible && !(editorTextFocus && vim.mode == 'Insert')" },
  { "key": "ctrl+left", "command": "workbench.action.navigateLeft", "when": "!inQuickOpen && !(editorTextFocus && vim.mode == 'Insert')" },
  { "key": "ctrl+down", "command": "workbench.action.navigateDown", "when": "!inQuickOpen && !(editorTextFocus && vim.mode == 'Insert')" },
  { "key": "ctrl+up", "command": "workbench.action.navigateUp", "when": "!inQuickOpen && !(editorTextFocus && vim.mode == 'Insert')" },
  { "key": "ctrl+right", "command": "workbench.action.navigateRight", "when": "!inQuickOpen && !(editorTextFocus && vim.mode == 'Insert')" },

  { "key": "ctrl+j", "command": "editor.action.moveLinesDownAction", "when": "editorTextFocus && vim.mode =~ /Visual/" },
  { "key": "ctrl+k", "command": "editor.action.moveLinesUpAction", "when": "editorTextFocus && vim.mode =~ /Visual/" },

  { "key": "ctrl+j", "command": "selectNextSuggestion", "when": "suggestWidgetVisible && textInputFocus" },
  { "key": "ctrl+k", "command": "selectPrevSuggestion", "when": "suggestWidgetVisible && textInputFocus" },
  { "key": "ctrl+space", "command": "toggleSuggestionDetails", "when": "suggestWidgetVisible && textInputFocus" },

  { "key": "ctrl+j", "command": "workbench.action.quickOpenSelectNext", "when": "inQuickOpen" },
  { "key": "ctrl+k", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen" },

  { "key": "ctrl+space", "command": "editor.action.showHover", "when": "editorTextFocus && vim.mode == 'Normal'" },

  { "key": "ctrl+q", "command": "-workbench.action.quit" },
  { "key": "ctrl+q", "command": "workbench.action.closeEditorsAndGroup", "when": "!terminalFocus" },

  { "key": "q", "command": "workbench.action.closePanel", "when": "focusedView == 'workbench.panel.markers.view' || focusedView == 'references-view.tree'" }
]
